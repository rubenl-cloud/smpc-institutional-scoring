# Educational three-party P1 score. Experimental, not an approved decision rule.
N = 7
MEDIAN_ANNUAL_CENTS = 1800000
POVERTY_PERCENT = 60
BURDEN_PERCENT = 10
WEIGHT_I2 = 45
WEIGHT_I3 = 40
WEIGHT_I4 = 15
for i in range(N):
    income = sint.get_input_from(0)
    electricity = sint.get_input_from(1)
    arrears = sint.get_input_from(1)
    non_electricity = sint.get_input_from(2)
    i2 = 100 * income < POVERTY_PERCENT * MEDIAN_ANNUAL_CENTS
    i3 = 100 * (electricity + non_electricity) > BURDEN_PERCENT * income
    i4 = arrears
    active = i3
    score = active * (WEIGHT_I2 * i2 + WEIGHT_I3 * i3 + WEIGHT_I4 * i4)
    print_ln('P1_ACTIVE %s P1_SCORE %s', active.reveal(), score.reveal())
